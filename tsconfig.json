{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "*": ["src/*", "apps/*/src"]
    },
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    "apps/frontend/src",
    "apps/frontend/vite-env.d.ts",
    "apps/frontend/index.html",
    "src",
    "vite-env.d.ts",
    "index.html"
  ]
}
