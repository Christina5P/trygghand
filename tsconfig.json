{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    // VIKTIGT: Sätter src som basurl för imports.
    "baseUrl": "./src", 
    "paths": {
      // VIKTIGT: Aliaset @/ pekar nu på alla filer i src/. Exempel: "@/lib" pekar på "./src/lib"
      "@/*": ["./*"] 
    },
    // Standardinställning för Next.js-projekt
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  // Exkludera din backend-mapp från frontend-kompileringen
  "exclude": ["node_modules", "backend"] 
}